{
  "manifest_version": 3,
  "name": "Draf Monev MagangHub",
  "version": "1.2.0",
  "minimum_chrome_version": "103",
  "description": "Susun laporan dari catatan singkat dan isi tiga kolom Monev secara otomatis.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["https://generativelanguage.googleapis.com/*"],
  "content_scripts": [
    {
      "matches": ["https://monev.maganghub.kemnaker.go.id/*"],
      "js": ["src/lib/monev-report.js", "src/content/auto-fill.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Draf Monev MagangHub",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
